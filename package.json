{
  "name": "cli-silo",
  "version": "0.2.0",
  "description": "Secure CLI platform for running AI agents in isolated Docker sandboxes",
  "type": "module",
  "author": "Divyansh Chaurasia",
  "homepage": "https://github.com/Asdivyansh/silo-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asdivyansh/silo-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Asdivyansh/silo-cli/issues"
  },
  "bin": {
    "silo": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "sandbox/",
    "policies/",
    "docs/",
    "install.sh",
    "uninstall.sh",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.1.0",
    "conf": "^12.0.0",
    "execa": "^8.0.1",
    "figures": "^6.1.0",
    "gradient-string": "^3.0.0",
    "inquirer": "^9.2.21",
    "ora": "^8.1.1",
    "picomatch": "^4.0.4",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/gradient-string": "^1.1.6",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.14.0",
    "@types/picomatch": "^4.0.2",
    "tsup": "^8.1.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "sandbox",
    "docker",
    "cli",
    "security",
    "isolation"
  ],
  "license": "MIT"
}
